      background-size: cover;
      background-position: center;
      z-index: 0;
    }
    .fp-hero::after {
      content: "";
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(10,15,30,0.45) 0%, rgba(10,15,30,0.75) 100%);
