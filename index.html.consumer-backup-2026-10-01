    .fp-hero .btn-outline {
      background: transparent;
      color: #fff;
      border-color: #fff;
    }
    .fp-hero .btn-outline:hover { background: rgba(255,255,255,0.15); }

    .fp-section { padding: 80px 0; }
    .fp-section.alt { background: #f7f9fb; }

    .fp-band-gray {
      width: 100%;
      height: 24px;
      background: #cbd5db;
    }

    .fp-photo-hero {
      position: relative;
      width: 100%;
      overflow: hidden;
      aspect-ratio: 16 / 7;
    }
    .fp-photo-hero img {
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
